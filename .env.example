# Local pilot; do not expose publicly without production authentication/TLS.
PORT=4100
ADMIN_PASSWORD=change-this-to-a-long-password
# Optional managed PostgreSQL. Default: embedded PostgreSQL (PGlite) in data/db.
DATABASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
FACEBOOK_GRAPH_VERSION=v26.0
# Production encryption key: 64 hex characters; local default saved in data/key.
ENCRYPTION_KEY=

# Optional X OAuth (PKCE); register this exact callback in X Developer Console.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:4100/oauth/x/callback
